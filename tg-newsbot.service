[Unit]
Description=Telegram news channel bot (RSS -> LLM summary -> channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-newsbot
ExecStart=/usr/bin/node /opt/tg-newsbot/dist/index.js
Restart=always
RestartSec=15
Environment=NODE_ENV=production
# Load secrets from .env in WorkingDirectory (BOT_TOKEN, LLM_*, etc.)
# The app reads dotenv itself; keep secrets out of this unit file.
# tz-less feed dates parse deterministically as UTC
Environment=TZ=UTC
# allow the graceful-shutdown waiter (max 30s) to finish before SIGKILL
TimeoutStopSec=40
# memory guard
MemoryMax=512M

[Install]
WantedBy=multi-user.target
