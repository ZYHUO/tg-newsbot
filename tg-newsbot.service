[Unit]
Description=Telegram news channel bot (RSS -> LLM summary -> channel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/tg-newsbot
ExecStart=/root/.hermes/node/bin/node /root/tg-newsbot/dist/index.js
Restart=always
RestartSec=15
Environment=NODE_ENV=production
# tz-less feed dates parse deterministically as UTC
Environment=TZ=UTC
# allow the graceful-shutdown waiter (max 30s) to finish before SIGKILL
TimeoutStopSec=40
# memory guard
MemoryMax=512M

[Install]
WantedBy=multi-user.target
