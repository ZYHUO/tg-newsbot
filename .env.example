# Telegram
BOT_TOKEN=123456:ABC-xxxxxxxx
CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# LLM (OpenAI-compatible; defaults to local gemini proxy)
LLM_ENDPOINT=http://127.0.0.1:8317/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite-preview

# Network
SOCKS_PROXY=socks5h://127.0.0.1:1080

# Behavior
POLL_INTERVAL_SEC=600
MAX_ITEM_AGE_HOURS=24
MIN_SECONDS_BETWEEN_POSTS=4
MAX_POSTS_PER_CYCLE=30
